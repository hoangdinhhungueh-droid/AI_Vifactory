"""Telegram inline-button helpers (two-way) for the VF pipeline.
Adds inline_keyboard send + callback answer + message edit on top of the
one-way notifier in telegram_notify.py. All network calls are FAIL-SAFE.
Includes idempotency lock to prevent duplicate Gate 2 messages.
"""
from __future__ import annotations
import os, html, json, time
from typing import Optional
import httpx
from loguru import logger

_API = "https://api.telegram.org"
_GATE2_SENT_DB = "/root/video_factory/db/gate2_sent.json"

def _token() -> str:
    return os.environ.get("VF_TG_BOT_TOKEN", "").strip() or os.environ.get("TELEGRAM_BOT_TOKEN", "").strip()

def _chat_id() -> str:
    return os.environ.get("TELEGRAM_CHAT_ID", "").strip()

def is_enabled() -> bool:
    if os.environ.get("TELEGRAM_ENABLED", "").strip() == "0":
        return False
    return bool(_token() and _chat_id())

def notion_page_url(page_id: str) -> str:
    if not page_id:
        return ""
    return "https://www.notion.so/" + str(page_id).replace("-", "")

def _load_gate2_ledger() -> dict:
    if os.path.exists(_GATE2_SENT_DB):
        try:
            with open(_GATE2_SENT_DB, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}

def _save_gate2_ledger(ledger: dict):
    os.makedirs(os.path.dirname(_GATE2_SENT_DB), exist_ok=True)
    try:
        with open(_GATE2_SENT_DB, "w", encoding="utf-8") as f:
            json.dump(ledger, f, indent=2, ensure_ascii=False)
    except Exception as e:
        logger.warning(f"[tg-btn] failed to save gate2 ledger: {e}")

def build_inline_keyboard(rows):
    kb = []
    for row in rows or []:
        kb_row = []
        for item in row:
            label = item[0]
            data = item[1] if len(item) > 1 else None
            url = item[2] if len(item) > 2 else None
            if url:
                kb_row.append({"text": str(label)[:64], "url": str(url)})
            else:
                safe = str(data).encode("utf-8")[:64].decode("utf-8", "ignore")
                kb_row.append({"text": str(label)[:64], "callback_data": safe})
        if kb_row:
            kb.append(kb_row)
    return {"inline_keyboard": kb}

async def send_with_buttons(text, rows, *, chat_id=None, disable_preview=True) -> Optional[int]:
    if not is_enabled():
        logger.debug("[tg-btn] disabled; skip")
        return None
    payload = {
        "chat_id": chat_id or _chat_id(),
        "text": text[:4096],
        "parse_mode": "HTML",
        "disable_web_page_preview": disable_preview,
        "reply_markup": build_inline_keyboard(rows),
    }
    try:
        async with httpx.AsyncClient(timeout=30) as client:
            r = await client.post(f"{_API}/bot{_token()}/sendMessage", json=payload)
        if r.status_code != 200:
            logger.warning(f"[tg-btn] send {r.status_code}: {r.text[:200]}")
            return None
        return r.json().get("result", {}).get("message_id")
    except Exception as e:
        logger.warning(f"[tg-btn] send error: {e}")
        return None

async def send_gate2_card(
    video_id: str,
    episode_id: str,
    title_a: str,
    title_b: str = "",
    duration_str: str = "14:07",
    scenes_count: int = 50,
    frames_count: int = 25421,
    bg_count: int = 10,
    fg_count: int = 7,
    force: bool = False
) -> Optional[int]:
    # Idempotency lock check: prevent duplicate spam
    ledger = _load_gate2_ledger()
    if not force and video_id in ledger:
        existing = ledger[video_id]
        logger.info(f"[tg-gate2] Gate 2 card already sent for video_id={video_id} (msg_id={existing.get('msg_id')}), skipping duplicate.")
        return existing.get("msg_id")

    watch_url = f"https://youtu.be/{video_id}"
    title_a_esc = html.escape(str(title_a))
    title_b_esc = html.escape(str(title_b or title_a))
    
    text = (
        "👑 <b>[HUMAN GATE 2] NGHIỆM THU EPISODE MASTER PRO & PHÁT HÀNH</b>\n\n"
        f"🎬 <b>Episode ID:</b> <code>{episode_id}</code>\n"
        f"⏱️ <b>Thời lượng:</b> {duration_str} ({scenes_count} scenes / {frames_count:,} frames / Full HD 1080p)\n"
        f"🎨 <b>Visual:</b> {bg_count} BGs 16:9 + {fg_count} FGs Cutouts\n"
        "🎙️ <b>Audio:</b> Edge-TTS GuyNeural (-14 LUFS) + Studio BGM (-24dB)\n"
        "🏷️ <b>Nhãn AI:</b> Altered or Synthetic Content: <b>BẬT (Yes)</b>\n"
        "🛡️ <b>Trạng thái hiện tại:</b> <b>Không công khai (Unlisted)</b>\n\n"
        "📌 <b>GÓI PACKAGING YOUTUBE 2026 (Rule 114):</b>\n"
        f"• <b>Title A (Primary):</b> <i>{title_a_esc}</i>\n"
        f"• <b>Title B (Backup A/B):</b> <i>{title_b_esc}</i>\n\n"
        "👉 <i>Vui lòng xem trước và bấm chọn 1 trong 4 hành động bên dưới:</i>"
    )
    
    buttons = [
        [("📺 Xem trước Video (Unlisted)", None, watch_url)],
        [("🚀 Chuyển sang Công Khai (Public)", f"pub:{video_id}")],
        [("🌐 Công Khai Tất cả Video (Public All)", "puball")],
        [("🔒 Giữ Không Công Khai (Unlisted)", f"kp:{video_id}")]
    ]
    msg_id = await send_with_buttons(text, buttons, disable_preview=False)
    if msg_id:
        ledger[video_id] = {
            "msg_id": msg_id,
            "episode_id": episode_id,
            "title_a": title_a,
            "title_b": title_b,
            "sent_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        }
        _save_gate2_ledger(ledger)
    return msg_id


async def send_gate1_card(en_pack: dict, jp_pack: dict, kr_pack: dict) -> Optional[int]:
    """Send Human Gate 1 Telegram card with 4 interactive buttons.
    Called from trend_gate_ai.py trend_virality endpoint after B1.3 virality scoring.
    en_pack/jp_pack/kr_pack: dicts with keys:
      top_subject, virality, topic_name_vi, search_specific_keyword,
      niche_angle_brief, story_direction_5_arcs, task_id
    Restored/created 2026-08-23 to fix Gate 1 not firing.
    """
    def _fmt(pack: dict, flag: str, market: str) -> str:
        subj = pack.get('top_subject', market)
        v = pack.get('virality', 0)
        name_vi = pack.get('topic_name_vi', subj)
        keyword = pack.get('search_specific_keyword', subj)
        niche = pack.get('niche_angle_brief', '')
        arcs = pack.get('story_direction_5_arcs', '')
        task_id = pack.get('task_id', f'{market.lower()}-topic-ep001')
        arcs_short = arcs[:220] + '...' if len(arcs) > 220 else arcs
        return (
            f"{flag} <b>Market {market}:</b> <code>{subj}</code> (Virality: {v})\n"
            f"• <b>Đề tài:</b> {name_vi}\n"
            f"• <b>Search-Specific Key:</b> <code>{keyword}</code>\n"
            f"• <b>Niche Brief:</b> {niche}\n"
            f"• <b>5-Act Direction:</b> {arcs_short}\n"
            f"👉 <b>Task ID:</b> <code>{task_id}</code>\n"
        )

    en_task = en_pack.get('task_id', 'en-topic-ep001')
    jp_task = jp_pack.get('task_id', 'jp-topic-ep001')
    kr_task = kr_pack.get('task_id', 'kr-topic-ep001')

    text = (
        "🎯 <b>[HUMAN GATE 1] PHÊ DUYỆT CHỦ ĐỀ SẢN XUẤT (GO-LIVE 2026)</b>\n"
        "<i>(✨ Suy luận chiến lược & Đúc kết ngách bởi GPT-5.6-Sol qua HHTech API)</i>\n\n"
        + _fmt(en_pack, '🇺🇸', 'EN') + "\n"
        + _fmt(jp_pack, '🇯🇵', 'JP') + "\n"
        + _fmt(kr_pack, '🇰🇷', 'KR') + "\n"
        + "--------------------------------------------------\n"
        + "💡 <i>Bấm <b>[Approve]</b> để duyệt kênh cần sản xuất. Copy <b>Task ID</b> dán vào Antigravity chat để bắt đầu B2-B10!</i>"
    )

    buttons = [
        [(f'🇺🇸 EN: Approve ✅', f'apr:{en_task}'), (f'🇺🇸 EN: Deny ❌', f'rej:{en_task}')],
        [(f'🇯🇵 JP: Approve ✅', f'apr:{jp_task}'), (f'🇯🇵 JP: Deny ❌', f'rej:{jp_task}')],
        [(f'🇰🇷 KR: Approve ✅', f'apr:{kr_task}'), (f'🇰🇷 KR: Deny ❌', f'rej:{kr_task}')],
        [(f'🚀 Approve Tất Cả 3 Kênh', 'ap_all'), ('❌ Deny Tất Cả', 'rj_all')]
    ]

    return await send_with_buttons(text, buttons)

async def answer_callback(callback_query_id: str, text: str = None, show_alert: bool = False):
    """Answer a Telegram callback query to stop the loading spinner on the button."""
    import httpx
    if not is_enabled(): return
    url = f"https://api.telegram.org/bot{_token()}/answerCallbackQuery"
    payload = {"callback_query_id": callback_query_id}
    if text:
        payload["text"] = text[:200]  # TG limit
    if show_alert:
        payload["show_alert"] = True
    try:
        async with httpx.AsyncClient(timeout=10) as c:
            await c.post(url, json=payload)
    except Exception as e:
        import logging
        logging.getLogger(__name__).warning(f"[tg-btn] answer_callback err: {e}")

async def edit_message_text(chat_id: str, message_id: int, text: str, rows: list = None):
    """Edit a message text and optionally its inline keyboard."""
    import httpx
    if not is_enabled(): return
    url = f"https://api.telegram.org/bot{_token()}/editMessageText"
    payload = {
        "chat_id": chat_id,
        "message_id": message_id,
        "text": text,
        "parse_mode": "HTML",
        "disable_web_page_preview": True
    }
    if rows is not None:
        payload["reply_markup"] = build_inline_keyboard(rows)
    try:
        async with httpx.AsyncClient(timeout=10) as c:
            r = await c.post(url, json=payload)
            if r.status_code != 200:
                import logging
                logging.getLogger(__name__).warning(f"[tg-btn] edit err: {r.text}")
    except Exception as e:
        import logging
        logging.getLogger(__name__).warning(f"[tg-btn] edit_message_text err: {e}")
