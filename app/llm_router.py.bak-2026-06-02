"""
LLM Router v3.4 — Priority Stack
  Tier A: OpenRouter free  (OR_FREE_MODEL=openrouter/free, 1000 req/day)
  Tier B: Groq             (llama-3.3-70b-versatile, 14400 req/day)
  Tier C-1: OnMay Gemini   (gemini-2.5-flash, 200 req/day — VPS_ONMAY only)
  Tier C-2: Gemini Studio  (gemini-2.5-flash, fallback 15 RPM)
  Tier D: Ollama local     (qwen2.5:7b, $0 forever)
"""
from dotenv import load_dotenv; load_dotenv("/root/secrets/.env")
from dotenv import load_dotenv; load_dotenv("/root/secrets/.env")
import os, json, asyncio, logging
from datetime import datetime
import httpx
import psycopg2

logger = logging.getLogger(__name__)

DATABASE_URL = os.getenv("DATABASE_URL", "")
GEMINI_DAILY_LIMIT = int(os.getenv("GEMINI_DAILY_LIMIT", "200"))

def _get_onmay_usage() -> int:
    """Đọc calls_count OnMay từ api_usage table."""
    try:
        conn = psycopg2.connect(DATABASE_URL)
        cur = conn.cursor()
        month = datetime.utcnow().strftime("%Y-%m")
        cur.execute(
            "SELECT calls_count FROM api_usage WHERE service=%s AND month=%s",
            ("onmay_gemini", month)
        )
        row = cur.fetchone()
        conn.close()
        return row[0] if row else 0
    except Exception as e:
        logger.warning(f"[llm_router] api_usage read failed: {e}")
        return 0

def _increment_onmay_usage():
    """Tăng calls_count OnMay +1."""
    try:
        conn = psycopg2.connect(DATABASE_URL)
        cur = conn.cursor()
        month = datetime.utcnow().strftime("%Y-%m")
        cur.execute("""
            INSERT INTO api_usage (service, month, calls_count)
            VALUES (%s, %s, 1)
            ON CONFLICT (service, month)
            DO UPDATE SET calls_count = api_usage.calls_count + 1
        """, ("onmay_gemini", month))
        conn.commit()
        conn.close()
    except Exception as e:
        logger.warning(f"[llm_router] api_usage write failed: {e}")

def _build_tiers() -> list:
    onmay_exhausted = _get_onmay_usage() >= GEMINI_DAILY_LIMIT

    tiers = [
        {
            "name": "openrouter",
            "key": os.getenv("OPENROUTER_API_KEY"),
            "base": os.getenv("OPENROUTER_BASE_URL", "https://openrouter.ai/api/v1"),
            "model": os.getenv("OR_FREE_MODEL", "openrouter/free"),
        },
        {
            "name": "groq",
            "key": os.getenv("GROQ_API_KEY"),
            "base": "https://api.groq.com/openai/v1",
            "model": "llama-3.3-70b-versatile",
        },
    ]

    if not onmay_exhausted:
        tiers.append({
            "name": "onmay_gemini",
            "key": os.getenv("ONMAY_API_KEY"),
            "base": os.getenv("ONMAY_BASE_URL", ""),
            "model": os.getenv("GEMINI_MODEL", "gemini-2.5-flash"),
            "_track_onmay": True,
        })

    tiers.append({
        "name": "gemini_studio",
        "key": os.getenv("GEMINI_API_KEY"),
        "base": "https://generativelanguage.googleapis.com/v1beta/openai",
        "model": os.getenv("GEMINI_MODEL", "gemini-2.5-flash"),
    })

    tiers.append({
        "name": "ollama",
        "key": "ollama",
        "base": os.getenv("OLLAMA_BASE_URL", "http://localhost:11434") + "/v1",
        "model": "qwen2.5:7b",
    })

    return tiers

async def llm_call(prompt: str, task_type: str = "default", max_tokens: int = 1024) -> dict:
    tiers = _build_tiers()
    for tier in tiers:
        if not tier.get("key"):
            continue
        if tier["name"] == "onmay_gemini" and not tier.get("base"):
            continue
        try:
            headers = {
                "Authorization": f"Bearer {tier['key']}",
                "Content-Type": "application/json",
            }
            payload = {
                "model": tier["model"],
                "messages": [{"role": "user", "content": prompt}],
                "max_tokens": max_tokens,
            }
            async with httpx.AsyncClient(timeout=45) as client:
                r = await client.post(
                    f"{tier['base']}/chat/completions",
                    headers=headers,
                    json=payload,
                )
                r.raise_for_status()
                text = r.json()["choices"][0]["message"]["content"]

            if tier.get("_track_onmay"):
                _increment_onmay_usage()

            logger.info(f"[llm_router] provider={tier['name']} task={task_type}")
            return {"text": text, "model": tier["model"], "provider": tier["name"]}

        except Exception as e:
            logger.warning(f"[llm_router] {tier['name']} failed: {e}")
            continue

    return {"text": "", "model": "none", "provider": "all_failed"}

if __name__ == "__main__":
    result = asyncio.run(llm_call("Say OK in one word", "test"))
    print(json.dumps(result, ensure_ascii=False, indent=2))
