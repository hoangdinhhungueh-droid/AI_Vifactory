{
  "$defs": {
    "KaraokeWord": {
      "additionalProperties": false,
      "description": "Word-level timestamp for Remotion karaoke subtitles.",
      "properties": {
        "word": {
          "title": "Word",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "word",
        "start",
        "end"
      ],
      "title": "KaraokeWord",
      "type": "object"
    },
    "SceneRenderProp": {
