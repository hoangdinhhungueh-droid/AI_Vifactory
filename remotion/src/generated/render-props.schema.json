        "$ref": "#/$defs/SceneRenderProp"
      },
      "title": "Scenes",
      "type": "array"
    },
    "bgm_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bgm Path"
    },
    "bgm_volume": {
      "default": 0.15,
      "title": "Bgm Volume",
      "type": "number"
    },
    "audio_spine_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Spine Path"
    }
  },
  "required": [
    "episode_id",
    "title",
    "duration_in_frames",
    "scenes"
