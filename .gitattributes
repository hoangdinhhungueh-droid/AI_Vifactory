# Set default behavior: enforce LF across all platforms (Rule 126 Parity)
* text=auto eol=lf

# Force LF on all source, doc, and data files
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# Windows-specific execution scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
