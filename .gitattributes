# Set default behavior: enforce LF across all platforms (Rule 126 Parity)
* text=auto eol=lf

# Force LF on all source, doc, and data files
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# Windows-specific execution scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Remotion and web assets enforce LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary media assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.mov binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
