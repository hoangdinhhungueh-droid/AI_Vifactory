{
  "code-quality-gate": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/pre_commit_linter.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "destructive-command-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/safety_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
